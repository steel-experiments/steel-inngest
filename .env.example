# Required: your Steel API key (find it at https://app.steel.dev).
STEEL_API_KEY=ste-your-key-here

# Keep the example endpoint in local Inngest dev mode.
INNGEST_DEV=1

# Optional: port for examples/server.ts. Defaults to 3000.
# PORT=3000

# Optional: page the monitor scrapes. Defaults to https://books.toscrape.com/
# PRICE_MONITOR_URL=https://books.toscrape.com/
