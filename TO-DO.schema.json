{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "steel-inngest task list",
  "type": "object",
  "required": ["schema_version", "source_files", "tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "source_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths to ground-truth docs; read them before picking a task."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{3}$" },
          "title": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "enum": ["todo", "doing", "blocked", "done"] },
          "details": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^T[0-9]{3}$" }
          },
          "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
